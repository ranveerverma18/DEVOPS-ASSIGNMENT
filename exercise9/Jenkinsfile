pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                dir('exercise9') {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir('exercise9') {
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp exercise9/app.py "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                        kill "$(cat "${WORKSPACE}/python-app-deploy/app.pid")" 2>/dev/null || true
                    fi

                    nohup "${WORKSPACE}/exercise9/.venv/bin/python" \
                        "${WORKSPACE}/python-app-deploy/app.py" \
                        > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 < /dev/null &

                    echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application response...'
                dir('exercise9') {
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}